from google.colab import drive
import os, cv2, glob, numpy as np
import shutil
drive.mount('/content/drive')

!pip install ultralytics
from ultralytics import SAM, YOLO

print("Dang khoi tao SAM Model...")
sam_model = SAM('sam_b.pt')

# Tạo thư mục chứa data YOLO
os.makedirs('/content/UCR2026_Dataset/images/train', exist_ok=True)
os.makedirs('/content/UCR2026_Dataset/labels/train', exist_ok=True)

# 1. Quét thẳng ảnh từ thư mục UCR_RAW trên Google Drive
raw_dir = '/content/drive/MyDrive/Train_UCR2026/UCR_RAW'
img_paths = glob.glob(f'{raw_dir}/**/*.jpg', recursive=True)
print(f"Tim thay {len(img_paths)} anh trong UCR_RAW. Bat dau auto-label...")

for i, p in enumerate(img_paths):
    img = cv2.imread(p)
    h, w = img.shape[:2]
    
    # 2. BỎ RẢI LƯỚI TOẠ ĐỘ MÙ QUÁNG
    # Thay bằng Smart Prompt: Dùng HSV scan nửa dưới màn hình, tìm pixel Đen(Nhựa đường)
    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
    v = hsv[:,:,2]; s = hsv[:,:,1]
    
    points, labels = [], []
    for y in range(h*2//3, h, 20):
        for x in range(10, w-10, 40):
            # Chỉ chấm mồi cho SAM nếu pixel đó tối (V<160) và có màu (S>20) -> Chắc chắn là đường
            if v[y, x] < 160 and s[y, x] > 20:
                points.append([x, y])
                labels.append(1)
                
    # Nếu xui xẻo không tìm thấy pixel đường nào (do chói tuyết), fallback về 1 điểm giữa mũi xe
    if not points: 
        points = [[w//2, h-5]]; labels = [1]
            
    # SAM nhan dien
    results = sam_model(img, points=[points], labels=[labels], device=0, verbose=False)
    mask = (results[0].masks.data[0].cpu().numpy() * 255).astype(np.uint8)
    
    # ĐÃ BỎ BƯỚC KHỬ NHIỄU (Vì cv2.RETR_EXTERNAL ở dưới tự động bọc màng lấp hố tuyết)
    
    # 3. Chuyển mask sang YOLO polygon
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if contours:
        c = max(contours, key=cv2.contourArea)
        if cv2.contourArea(c) > (h*w*0.05):
            c = c.reshape(-1, 2).astype(np.float32)
            c[:, 0] /= w; c[:, 1] /= h
            
            # Lưu ảnh & label vào thư mục train
            name = os.path.basename(p)
            txt_name = name.replace('.jpg', '.txt')
            cv2.imwrite(f'/content/UCR2026_Dataset/images/train/{name}', img)
            
            with open(f'/content/UCR2026_Dataset/labels/train/{txt_name}', 'w') as f:
                coords = " ".join([f"{x:.4f} {y:.4f}" for x, y in c])
                f.write(f"0 {coords}\n")
                
    if i % 100 == 0: print(f"  Da label {i}/{len(img_paths)} anh...")

# 4. Tạo file data.yaml
yaml_content = """path: /content/UCR2026_Dataset
train: images/train
val: images/train
nc: 1
names:
  0: road"""
with open('/content/UCR2026_Dataset/data.yaml', 'w') as f: f.write(yaml_content)

# 5. Bắt đầu Train YOLO
print("Label xong! Bat dau train YOLO...")
model = YOLO('/content/drive/MyDrive/Train_UCR2026/best4.pt')
model.train(
    data='/content/UCR2026_Dataset/data.yaml',
    epochs=50, imgsz=640, batch=16, workers=2, cache='disk', device=0,
    patience=15, optimizer='AdamW', lr0=1e-3, lrf=1e-5, fliplr=0.0, hsv_v=0.4,
    project='/content/drive/MyDrive', name='snow_map_sam_model_final'
)